# ═══ OBLIGATOIRE EN PRODUCTION ══════════════════════════════════════════════
# Sans ces deux variables, l'application demarre, sert le site public, mais
# ferme completement le back-office : aucune session ne peut etre validee.
# C'est voulu — un secret ecrit dans le depot n'est pas un secret.
#
# Generer : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=
# Comptes back-office : "email:motdepasse:role" separes par des points-virgules.
# Roles : admin (fournisseurs, annulation de lots) ou editeur.
ADMIN_ACCOUNTS=

# ═══ RECOMMANDE ═════════════════════════════════════════════════════════════
# Sel de hachage des adresses IP. A defaut, repli sur AUTH_SECRET.
IP_SALT=
# Autorise l'invalidation de cache par un appel externe.
REVALIDATE_SECRET=

# ═══ BASE DE DONNEES ════════════════════════════════════════════════════════
# Sans ces variables, magasin local JSON (data/local-db.json) : pratique en
# developpement, inadapte a la production (pas de partage entre instances).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ═══ MEDIAS ═════════════════════════════════════════════════════════════════
# Sans Cloudinary, les photos compressees dans le navigateur sont conservees
# en base sous forme de data URL. A configurer avant la mise en production.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Filigrane. `npm run filigrane` fabrique public/filigrane.png a partir du
# logo ; televersez ce fichier une fois dans la bibliotheque Cloudinary et
# reportez ici son public id (par exemple moto-import/filigrane). Renseigne,
# la marque est incrustee par Cloudinary dans chaque photo servie ; laisse
# vide, Cloudinary se rabat sur un simple texte, et sans Cloudinary du tout
# la marque est incrustee des l'envoi puis rappelee en surcouche a l'ecran.
NEXT_PUBLIC_CLOUDINARY_FILIGRANE_ID=

# ═══ SITE ═══════════════════════════════════════════════════════════════════
NEXT_PUBLIC_SITE_URL=https://moto-import.com
NEXT_PUBLIC_WHATSAPP_NUMBER=261340000000
NEXT_PUBLIC_ADRESSE=Lot II M 85 Bis, Analamahitsy, Antananarivo 101

# ═══ MONITORING ═════════════════════════════════════════════════════════════
SENTRY_DSN=
